<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AmiDiskLab.App.App"
             xmlns:local="using:AmiDiskLab.App"
             Name="AmiDiskLab"
             RequestedThemeVariant="Default">
  <NativeMenu.Menu>
    <NativeMenu NeedsUpdate="MenuNeedsUpdate">
      <NativeMenuItem Header="About AmiDiskLab" Click="AboutMenu_Click" IsEnabled="False"/>
      <NativeMenuItemSeparator/>
      <NativeMenuItem Header="Settings…" Click="SettingsMenu_Click" Gesture="Meta+OemComma" IsEnabled="False"/>
      <NativeMenuItem Header="Refresh Collection" Click="RefreshMenu_Click" Gesture="Meta+R" IsEnabled="False"/>
    </NativeMenu>
  </NativeMenu.Menu>
  <Application.DataTemplates>
    <local:ViewLocator/>
  </Application.DataTemplates>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F6F7"/>
          <SolidColorBrush x:Key="AppPanelBrush" Color="#EAF0F0"/>
          <SolidColorBrush x:Key="AppRowBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="AppRowHoverBrush" Color="#EEF4F3"/>
          <SolidColorBrush x:Key="AppSelectedRowBrush" Color="#DCECEA"/>
          <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#53646A"/>
          <SolidColorBrush x:Key="AppAccentBrush" Color="#216F69"/>
          <SolidColorBrush x:Key="AppBorderBrush" Color="#D5DEE0"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#151C21"/>
          <SolidColorBrush x:Key="AppPanelBrush" Color="#1A2328"/>
          <SolidColorBrush x:Key="AppRowBrush" Color="#202A30"/>
          <SolidColorBrush x:Key="AppRowHoverBrush" Color="#29373D"/>
          <SolidColorBrush x:Key="AppSelectedRowBrush" Color="#294846"/>
          <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#B1C1C6"/>
          <SolidColorBrush x:Key="AppAccentBrush" Color="#68CBBE"/>
          <SolidColorBrush x:Key="AppBorderBrush" Color="#37454C"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#216F69"/>
        <ColorPaletteResources x:Key="Dark" Accent="#68CBBE"/>
      </FluentTheme.Palettes>
    </FluentTheme>
  </Application.Styles>
</Application>