<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AmiDiskLab.App.Views.VolumeNameWindow"
        Icon="/Assets/AmiDiskLab.ico"
        Background="#34383F"
        Title="Create Amiga Disk"
        Width="420"
        Height="210"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

	<StackPanel Margin="24"
							Spacing="12">

		<TextBlock Text="Create Amiga Disk"
							 FontSize="20"
							 FontWeight="Bold"/>

		<TextBlock Text="Volume name:"/>

		<TextBox x:Name="VolumeNameTextBox"
						 Text="NEWDISK"
						 MaxLength="30"
						 Watermark="Enter volume name"/>

		<Grid ColumnDefinitions="*,Auto,Auto"
					ColumnSpacing="8"
					Margin="0,10,0,0">

			<Button Grid.Column="1"
							Content="Cancel"
							Width="90"
							Click="Cancel_Click"/>

			<Button Grid.Column="2"
							Content="Create"
							Width="90"
							Click="Create_Click"/>

		</Grid>

	</StackPanel>

</Window>
